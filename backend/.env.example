# HaveIBeenPwned API key (paid, https://haveibeenpwned.com/API/Key). Required for real breach lookups.
HIBP_API_KEY=
# Set to 1 to return clearly-labelled SAMPLE breach data without calling HIBP (local UI development only).
HIBP_DEMO=0
# Contact string sent in the User-Agent header to HIBP / crt.sh
APP_CONTACT=https://github.com/<your-username>/exposurecheck-india
# SQLite by default; use a PostgreSQL URL in production (stores aggregate counters only).
DATABASE_URL=sqlite:///./exposurecheck.db
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
# Set to 1 only when running behind a trusted reverse proxy (Render/Railway) so X-Forwarded-For is used for rate limiting
TRUST_PROXY=0
RATE_LIMIT_PER_MINUTE=5
RATE_LIMIT_PER_HOUR=30
GLOBAL_RATE_LIMIT_PER_MINUTE=8
